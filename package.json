{
  "name": "@talha7k/zatca",
  "version": "0.13.0",
  "description": "ZATCA Phase 2 e-invoicing integration for Saudi Arabia — TypeScript, framework-agnostic, production-grade",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist.cjs/index.cjs"
    },
    "./qrcode": {
      "types": "./dist/qrcode/index.d.ts",
      "import": "./dist/qrcode/index.js",
      "require": "./dist.cjs/qrcode/index.cjs"
    },
    "./signing/p1363-to-der": {
      "types": "./dist/signing/p1363-to-der.d.ts",
      "import": "./dist/signing/p1363-to-der.js",
      "require": "./dist.cjs/signing/p1363-to-der.cjs"
    },
    "./hash-chain": {
      "types": "./dist/hash-chain/index.d.ts",
      "import": "./dist/hash-chain/index.js",
      "require": "./dist.cjs/hash-chain/index.cjs"
    },
    "./browser": {
      "types": "./dist/browser/index.d.ts",
      "import": "./dist/browser/index.js",
      "require": "./dist.cjs/browser/index.cjs"
    },
    "./effect": {
      "types": "./dist/effect/index.d.ts",
      "import": "./dist/effect/index.js",
      "require": "./dist.cjs/effect/index.cjs"
    }
  },
  "scripts": {
    "build": "tsc && tsup",
    "dev": "tsc --watch",
    "type-check": "tsc --noEmit",
    "test": "bun test",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build",
    "lint": "eslint src/",
    "build:cjs": "tsup"
  },
  "dependencies": {
    "@talha7k/zatca-qr": "^1.2.2",
    "@xmldom/xmldom": "^0.9.12",
    "effect": "4.0.0-rc.115",
    "xmldsigjs": "^2.8.8"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "@types/qrcode": "^1.5.6",
    "fast-xml-parser": "^5.11.1",
    "qrcode": "^1.5.0 || ^2.0.0",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "qrcode": "^1.5.0 || ^2.0.0"
  },
  "peerDependenciesMeta": {
    "qrcode": {
      "optional": true
    }
  },
  "overrides": {
    "fast-xml-builder": "1.2.0"
  },
  "pnpm": {
    "overrides": {
      "fast-xml-builder": "1.2.0"
    }
  },
  "files": [
    "dist/",
    "dist.cjs/"
  ],
  "keywords": [
    "zatca",
    "e-invoicing",
    "saudi-arabia",
    "fatoora",
    "ubl",
    "ubl21",
    "vat",
    "saudi",
    "invoice",
    "qr-code",
    "digital-signature",
    "ecdsa",
    "tax",
    "typescript",
    "phase1",
    "phase2",
    "xml-dsig",
    "ber-tlv"
  ],
  "author": {
    "name": "talha7k",
    "email": "talha7k@gmail.com",
    "url": "https://github.com/talha7k"
  },
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/talha7k/zatca.git"
  },
  "bugs": {
    "url": "https://github.com/talha7k/zatca/issues"
  },
  "homepage": "https://github.com/talha7k/zatca#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/talha7k"
  }
}
